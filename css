/* Configurações gerais para leitura confortável e sem animações */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Verdana, Arial, Helvetica, sans-serif;
  font-size: 18px;
  line-height: 1.6;
  background-color: #F4F6F8; /* Fundo suave para evitar brilho excessivo */
  color: #1A202C; /* Texto escuro com alto contraste */
}

/* Container centralizado de coluna única */
.container {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Cabeçalho */
header {
  background-color: #0F4C81; /* Azul calmo e de alto contraste */
  color: #FFFFFF;
  padding: 32px 0;
  border-bottom: 4px solid #093154;
}

header h1 {
  font-size: 30px;
  margin-bottom: 10px;
}

header p {
  font-size: 18px;
}

/* Menu de navegação previsível */
nav {
  background-color: #FFFFFF;
  border-bottom: 2px solid #CBD5E1;
  padding: 14px 0;
}

nav ul {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

nav a {
  color: #0F4C81;
  text-decoration: underline;
  font-weight: bold;
  padding: 6px 10px;
  border-radius: 4px;
}

nav a:hover,
nav a:focus {
  background-color: #E2E8F0;
  outline: 3px solid #0F4C81;
}

/* Seções de conteúdo */
main {
  padding-top: 24px;
  padding-bottom: 40px;
}

.bloco {
  background-color: #FFFFFF;
  border: 2px solid #CBD5E1;
  border-radius: 8px;
  padding: 28px;
  margin-bottom: 24px;
}

h2 {
  font-size: 24px;
  color: #0F4C81;
  margin-bottom: 14px;
  border-bottom: 2px solid #E2E8F0;
  padding-bottom: 8px;
}

p {
  margin-bottom: 16px;
}

/* Imagem */
.imagem-container {
  margin: 20px 0;
  text-align: center;
}

.imagem-container img {
  max-width: 100%;
  height: auto;
  border: 2px solid #CBD5E1;
  border-radius: 6px;
}

figcaption {
  font-size: 15px;
  color: #475569;
  margin-top: 8px;
}

/* Botões fáceis de identificar */
.grupo-botoes {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 20px;
}

.botao {
  display: inline-block;
  background-color: #0F4C81;
  color: #FFFFFF;
  text-decoration: none;
  font-weight: bold;
  padding: 14px 24px;
  border-radius: 6px;
  border: 2px solid #0F4C81;
}

.botao-secundario {
  background-color: #FFFFFF;
  color: #0F4C81;
}

.botao:hover,
.botao:focus {
  outline: 3px solid #D97706; /* Destaque claro ao navegar por teclado ou mouse */
  outline-offset: 2px;
}

/* Blocos de Informações Importantes */
.lista-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 16px;
}

.item-info {
  background-color: #F8FAFC;
  border: 2px solid #CBD5E1;
  border-radius: 6px;
  padding: 16px;
}

.item-info h3 {
  font-size: 18px;
  color: #0F4C81;
  margin-bottom: 6px;
}

.item-info p {
  margin-bottom: 0;
  font-weight: bold;
}

/* Listas de Dicas e Contato */
.lista-dicas {
  margin-left: 24px;
  margin-top: 12px;
}

.lista-dicas li {
  margin-bottom: 12px;
}

/* Rodapé */
footer {
  background-color: #E2E8F0;
  color: #1A202C;
  text-align: center;
  padding: 20px 0;
  border-top: 2px solid #CBD5E1;
  font-size: 16px;
}

/* Ajuste para telas pequenas (celulares) */
@media (max-width: 600px) {
  .lista-info {
    grid-template-columns: 1fr;
  }
}
